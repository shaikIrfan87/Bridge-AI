# Example Environment Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env with real secrets to version control

# =====================================================
# API Configuration
# =====================================================
API_HOST=0.0.0.0
API_PORT=19440

# Set to False for production - debug mode disabled
API_DEBUG=False
API_RELOAD=False


# =====================================================
# Security - REQUIRED FOR PRODUCTION
# =====================================================

# Generate a unique secret key for JWT signing:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-at-least-32-characters

# Allowed origins for CORS (comma-separated)
# Add your frontend domain(s) here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19440,https://yourdomain.com


# =====================================================
# Gemini AI API Key
# =====================================================
# Get your key from: https://aistudio.google.com/apikey
# CRITICAL: Do NOT share or commit this to version control
GEMINI_API_KEY=your-gemini-api-key-here


# =====================================================
# File Upload Configuration
# =====================================================
# Maximum file size in MB
MAX_FILE_SIZE_MB=10

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=pdf,docx


# =====================================================
# JWT Token Configuration
# =====================================================
# Token expiration time
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# =====================================================
# Code Execution Configuration
# =====================================================
# Maximum time to wait for code execution (seconds)
CODE_TIMEOUT_SECONDS=5

# Maximum output length from code execution
MAX_CODE_OUTPUT_LENGTH=5000


# =====================================================
# Application Metadata
# =====================================================
APP_NAME=Bridge AI
APP_VERSION=1.0.0
